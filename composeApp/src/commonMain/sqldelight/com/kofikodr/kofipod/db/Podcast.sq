CREATE TABLE Podcast (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    description TEXT NOT NULL,
    artworkUrl TEXT NOT NULL,
    feedUrl TEXT NOT NULL,
    listId TEXT,
    autoDownloadEnabled INTEGER NOT NULL DEFAULT 0,
    notifyNewEpisodesEnabled INTEGER NOT NULL DEFAULT 1,
    lastCheckedAt INTEGER,
    addedAt INTEGER NOT NULL,
    primaryCategory TEXT NOT NULL DEFAULT '',
    -- Per-podcast "seen" watermark (epoch millis). NULL = never opened since subscribing.
    -- Set to now when the user dwells on the podcast's episode list; the new-episode-count
    -- query treats NULL as 0 so behavior is unchanged until a podcast is first seen.
    lastSeenAt INTEGER,
    FOREIGN KEY (listId) REFERENCES PodcastList(id) ON DELETE SET NULL
);

CREATE INDEX podcast_listId ON Podcast(listId);

insert:
INSERT INTO Podcast
(id, title, author, description, artworkUrl, feedUrl, listId, autoDownloadEnabled, notifyNewEpisodesEnabled, lastCheckedAt, addedAt, primaryCategory)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    title = excluded.title,
    author = excluded.author,
    description = excluded.description,
    artworkUrl = excluded.artworkUrl,
    feedUrl = excluded.feedUrl,
    primaryCategory = excluded.primaryCategory;

selectAll:
SELECT * FROM Podcast ORDER BY title COLLATE NOCASE ASC;

selectById:
SELECT * FROM Podcast WHERE id = ?;

countByArtworkUrl:
SELECT COUNT(*) FROM Podcast WHERE artworkUrl = ?;

selectByList:
SELECT * FROM Podcast WHERE listId IS ? ORDER BY title COLLATE NOCASE ASC;

moveToList:
UPDATE Podcast SET listId = ? WHERE id = ?;

setAutoDownload:
UPDATE Podcast SET autoDownloadEnabled = ? WHERE id = ?;

setNotifyNewEpisodes:
UPDATE Podcast SET notifyNewEpisodesEnabled = ? WHERE id = ?;

setLastChecked:
UPDATE Podcast SET lastCheckedAt = ? WHERE id = ?;

setLastSeen:
UPDATE Podcast SET lastSeenAt = ? WHERE id = ?;

delete:
DELETE FROM Podcast WHERE id = ?;
