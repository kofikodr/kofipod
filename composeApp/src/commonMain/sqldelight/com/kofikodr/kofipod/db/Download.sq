CREATE TABLE Download (
    episodeId TEXT NOT NULL PRIMARY KEY,
    state TEXT NOT NULL,
    localPath TEXT,
    downloadedBytes INTEGER NOT NULL DEFAULT 0,
    totalBytes INTEGER NOT NULL DEFAULT 0,
    source TEXT NOT NULL,
    startedAt INTEGER,
    completedAt INTEGER,
    errorMessage TEXT,
    FOREIGN KEY (episodeId) REFERENCES Episode(id) ON DELETE CASCADE
);

CREATE INDEX download_state ON Download(state);
CREATE INDEX download_source_completed ON Download(source, completedAt);

upsert:
INSERT OR REPLACE INTO Download
(episodeId, state, localPath, downloadedBytes, totalBytes, source, startedAt, completedAt, errorMessage)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM Download;

selectAllWithMeta:
SELECT
    d.episodeId,
    d.state,
    d.localPath,
    d.downloadedBytes,
    d.totalBytes,
    d.source,
    d.startedAt,
    d.completedAt,
    d.errorMessage,
    e.title       AS episodeTitle,
    e.podcastId   AS podcastId,
    p.title       AS podcastTitle,
    p.artworkUrl  AS artworkUrl
FROM Download d
LEFT JOIN Episode e ON e.id = d.episodeId
LEFT JOIN Podcast p ON p.id = e.podcastId;

selectByEpisode:
SELECT * FROM Download WHERE episodeId = ?;

selectByState:
SELECT * FROM Download WHERE state = ?;

selectAutoCompletedOldestFirst:
SELECT * FROM Download WHERE source = 'Auto' AND state = 'Completed' ORDER BY completedAt ASC;

-- Eviction accounting deliberately counts Auto bytes only: eviction can never
-- reclaim Manual downloads, so counting Manual bytes against the cap purged
-- every completed auto download on every daily worker run once manual bytes
-- alone exceeded the cap.
autoCompletedBytes:
SELECT COALESCE(SUM(totalBytes), 0) AS total FROM Download WHERE state = 'Completed' AND source = 'Auto';

updateState:
UPDATE Download SET state = ?, errorMessage = ? WHERE episodeId = ?;

-- Startup recovery, step 1: interrupted Auto downloads self-heal via the
-- WaitingForWifi flush machinery (no user is watching them, and the daily
-- worker's inserted>0 trigger never re-fires for an already-inserted episode).
deferInterruptedAutoOnStartup:
UPDATE Download SET state = 'WaitingForWifi', errorMessage = NULL
WHERE state IN ('Queued', 'Downloading') AND source = 'Auto';

-- Startup recovery, step 2: Manual interrupted rows become Paused, i.e. visibly
-- user-resumable from the Downloads screen. Excludes Auto explicitly so the two
-- startup statements stay correct regardless of execution order.
pauseActiveOnStartup:
UPDATE Download SET state = 'Paused', errorMessage = NULL
WHERE state IN ('Queued', 'Downloading') AND source <> 'Auto';

updateProgress:
UPDATE Download SET downloadedBytes = ?, totalBytes = ? WHERE episodeId = ?;

markCompleted:
UPDATE Download
SET state = 'Completed',
    errorMessage = NULL,
    localPath = ?,
    downloadedBytes = ?,
    totalBytes = ?,
    completedAt = ?
WHERE episodeId = ?;

localPathFor:
SELECT localPath FROM Download WHERE episodeId = ? AND state = 'Completed';

selectCompletedWithMeta:
SELECT
    d.episodeId,
    d.localPath,
    d.completedAt,
    e.title       AS episodeTitle,
    e.podcastId   AS podcastId,
    p.title       AS podcastTitle,
    p.artworkUrl  AS artworkUrl
FROM Download d
INNER JOIN Episode e ON e.id = d.episodeId
INNER JOIN Podcast p ON p.id = e.podcastId
WHERE d.state = 'Completed'
ORDER BY d.completedAt DESC;


delete:
DELETE FROM Download WHERE episodeId = ?;
