-- Single-row cache for the daily "For You" recommendations. Always id = 0; we INSERT OR
-- REPLACE on every refresh so no history accumulates and the row stays fresh.
-- payloadJson is a serialized List<PodcastSummary> so the row can render without a network
-- round-trip on app cold start.
CREATE TABLE RecommendationCache (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 0,
    computedEpochDay INTEGER NOT NULL,
    payloadJson TEXT NOT NULL,
    reshufflesUsed INTEGER NOT NULL DEFAULT 0
);

select:
SELECT computedEpochDay, payloadJson, reshufflesUsed FROM RecommendationCache WHERE id = 0;

upsert:
INSERT OR REPLACE INTO RecommendationCache(id, computedEpochDay, payloadJson, reshufflesUsed)
VALUES (0, ?, ?, ?);

clear:
DELETE FROM RecommendationCache WHERE id = 0;
