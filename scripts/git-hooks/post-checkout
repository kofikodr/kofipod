#!/usr/bin/env sh
# Post-checkout hook: seed a freshly-added git worktree with the gitignored local
# build config so worktree builds work without manual copying.
#
# `git worktree add` runs post-checkout in the new worktree with the branch-checkout
# flag set. We copy the gitignored local build config from the primary worktree into
# the new one when it's missing:
#   - local.properties      SDK location + the Podcast Index dev key (debug builds pick
#                           the key up automatically via readSecret / the per-variant
#                           wiring in composeApp/build.gradle.kts).
#   - keystore.properties   release signing config, and
#   - keystore/             the signing keystore dir (holds release.jks),
#                           so signed/release builds also work from a worktree.
#
# No-op per item when: this is a file checkout (flag != 1), this IS the primary
# worktree, the source is absent, or the destination already exists. Never overwrites.
#
# Activated (alongside pre-commit) by `./gradlew installGitHooks`, which points
# core.hooksPath at scripts/git-hooks/.
#
# Args: $1 = old HEAD, $2 = new HEAD, $3 = 1 for a branch checkout (incl. worktree add).
set -eu

# Only branch checkouts (worktree add sets flag=1); ignore per-file checkouts.
[ "${3:-0}" = "1" ] || exit 0

# Primary worktree = parent of the shared git common dir.
common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
primary=$(dirname "$common_dir")

# The worktree this checkout is populating.
here=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Nothing to seed when the checkout is the primary worktree itself.
[ "$here" = "$primary" ] && exit 0

# Seed one gitignored path (file or directory) into this worktree, if the primary
# has it and this worktree doesn't. `-e`/`cp -R` handle both files and dirs; the
# `! -e` guard means an existing destination is never overwritten.
seed() {
    _src="$primary/$1"
    _dst="$here/$1"
    if [ -e "$_src" ] && [ ! -e "$_dst" ]; then
        cp -R "$_src" "$_dst"
        echo "post-checkout: seeded $1 into new worktree from $primary"
    fi
}

seed local.properties
seed keystore.properties
seed keystore
